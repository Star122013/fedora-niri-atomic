{
  # Install order matters for layer caching: put the most stable,
  # foundational packages first so they land in early (cached) layers,
  # and the frequently-changing ones (desktop, gaming) last.
  #
  # NOTE: keep this list in sync with the RUN layers in the Containerfile.
  install_order: ["system" "fonts" "services" "utils" "desktop" "gaming"]

  reinstall: []

  groups: {
    # ---------------------------------------------------------------
    # system  — foundational, very rarely churn (cached best)
    # ---------------------------------------------------------------
    system: [
      "zram-generator"
      "mesa-vulkan-drivers"
    ]

    # ---------------------------------------------------------------
    # fonts
    # ---------------------------------------------------------------
    fonts: [
      "google-noto-sans-fonts"
    ]

    # ---------------------------------------------------------------
    # services  — daemons / virtualization / audio / network
    # ---------------------------------------------------------------
    services: [
      # virtualization
      "qemu-kvm"
      "libvirt-daemon-kvm"
      "libvirt-daemon-config-network"
      "libvirt-client"
      "virt-install"
      "virt-manager"
      "virt-viewer"
      "edk2-ovmf"
      "swtpm"
      "dnsmasq"
      # audio
      "pipewire"
      "pipewire-utils"
      "wireplumber"
      "pipewire-alsa"
      "pipewire-pulseaudio"
      # network
      "NetworkManager-wifi"
      "iwlwifi-mvm-firmware"
      "dae"
      "sing-box"
      # system daemons
      "colord"
      "upower"
      "firewalld"
    ]

    # ---------------------------------------------------------------
    # utils  — CLI / dev / container tooling
    # ---------------------------------------------------------------
    utils: [
      # package & container management
      "copr-cli"
      "distrobox"
      "image-builder"
      "skopeo"
      # nix package manager
      "nix"
      "nix-daemon"
      "nix-filesystem"
      "nix-system"
      "nix-legacy"
      # dev toolchain
      "gcc"
      "git"
      # archives / misc cli
      "curl"
      "unzip"
      "p7zip"
      "busybox"
      # graphics / system
      "vulkan-tools"
      "pciutils"
      "xdg-utils"
      "glibc-langpack-en"
    ]

    # ---------------------------------------------------------------
    # desktop  — GUI session, changes most often (cached worst)
    # ---------------------------------------------------------------
    desktop: [
      # window managers
      "hyprland"
      "niri"
      # display manager
      "ly"
      # file managers
      "nautilus"
      "dolphin"
      # desktop portals
      "xdg-desktop-portal"
      "xdg-desktop-portal-gnome"
      "xdg-desktop-portal-gtk"
      "xdg-desktop-portal-hyprland"
      # terminal emulators
      "foot"
      "foot-terminfo"
      "ghostty"
      # screenshot
      "grim"
      "slurp"
      "satty"
      # clipboard
      "cliphist"
      # recording / shell
      "gpu-screen-recorder"
      "noctalia-git"
      # input method (Chinese)
      "fcitx5"
      "fcitx5-configtool"
      "fcitx5-chinese-addons"
      "fcitx5-rime"
      # flatpak
      "flatpak"
    ]

    gaming: []
  }

  remove: [
    "firefox"
    "firefox-langpacks"
    "brlapi"
  ]
}
