[Unit]
Description=Download sing-box node config from SubStore
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Desktop pulls the same node config the router's SubStore serves.
# http://10.10.10.1:3001 is the router's SubStore (SUB_STORE_FRONTEND_BACKEND_PATH=/qwerhyy123).
ExecStart=/usr/bin/curl -s -f -m 30 -o /etc/singbox/node.json 'http://10.10.10.1:3001/qwerhyy123/download/collection/singbox?target=sing-box'
ExecStartPost=/usr/bin/systemctl try-restart singbox.service